set -e

# The dump holds the notification credentials
umask 077

podman exec uptime-kuma-mariadb sh -c 'MYSQL_PWD="${MARIADB_ROOT_PASSWORD}" exec mariadb-dump -uroot --databases "${MARIADB_DATABASE}" --default-character-set=utf8mb4 --single-transaction --quick --add-drop-table --skip-dump-date' > uptime-kuma.sql.tmp
mv uptime-kuma.sql.tmp uptime-kuma.sql
