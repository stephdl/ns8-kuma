#
# This systemd unit starts a kuma instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman kuma.service
Requires=kuma-mariadb.service kuma-app.service
Before=kuma-mariadb.service kuma-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/kuma.pid %t/kuma.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/kuma.pid  --pod-id-file %t/kuma.pod-id  --name kuma  --publish 127.0.0.1:${TCP_PORT}:3001  --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/kuma.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/kuma.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/kuma.pod-id
PIDFile=%t/kuma.pid
Type=forking

[Install]
WantedBy=default.target
