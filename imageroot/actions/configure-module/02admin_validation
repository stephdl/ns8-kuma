import os
import re
import sys
import json
import agent

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)
password = data.get("admin_password", "")

if not password:
    sys.exit(0)

# Same rule as the "Too weak" level of check-password-strength used by Uptime Kuma
classes = [r"[a-z]", r"[A-Z]", r"[0-9]", r"[^a-zA-Z0-9]"]
if len(password) < 6 or sum(1 for c in classes if re.search(c, password)) < 2:
    agent.set_status('validation-failed')
    json.dump([{'field':'admin_password','parameter':'admin_password','value':'','error':'admin_password_too_weak'}],fp=sys.stdout)
    sys.exit(2)
